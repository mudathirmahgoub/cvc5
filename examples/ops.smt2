(set-logic ALL)
(declare-fun A () (Set Int))
(declare-fun B () (Set Int))
(declare-fun C () (Set Int))
(declare-fun x () Int)
(assert (= C (set.inter A (set.insert 1 2 (set.singleton 3)))))
(assert (set.subset (set.minus A B) C))
(assert (set.member x (set.union A B)))
(assert (not (set.is_empty C)))
(assert (forall ((S (Set Int))) (=> (set.subset S A) (set.subset S (set.union A B)))))
(check-sat)
