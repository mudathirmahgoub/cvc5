 void TheorySetsRels::sendInfer(Node fact, InferenceId id, Node reason)
 {
+  // EVIDENCE: the witness lemmas sent by the last-call completion are counted
+  // as one rule; --rels-evidence-disable drops the given rules
+  InferenceId eff = id;
+  if (d_evidenceLastCall
+      && (id == InferenceId::SETS_RELS_UNROLL_CYCLE
+          || id == InferenceId::SETS_RELS_SPLIT_CYCLE_LEN
+          || id == InferenceId::SETS_RELS_ALTERNATE
+          || id == InferenceId::SETS_RELS_ALT_CLOSE
+          || id == InferenceId::SETS_RELS_CHORD
+          || id == InferenceId::SETS_RELS_DISTINCT
+          || id == InferenceId::SETS_RELS_BACKWARD))
+  {
+    eff = InferenceId::SETS_RELS_LAST_CALL_COMPLETION;
+  }
+  if (!d_evidenceParsed)
+  {
+    d_evidenceParsed = true;
+    std::string ids = options().sets.relsEvidenceDisable;
+    size_t start = 0;
+    while (start <= ids.size())
+    {
+      size_t comma = ids.find(',', start);
+      std::string one = ids.substr(
+          start, comma == std::string::npos ? std::string::npos : comma - start);
+      if (!one.empty())
+      {
+        d_evidenceDisabled.insert(one);
+      }
+      if (comma == std::string::npos)
+      {
+        break;
+      }
+      start = comma + 1;
+    }
+  }
+  if (!d_evidenceDisabled.empty()
+      && (d_evidenceDisabled.count(toString(id))
+          || d_evidenceDisabled.count(toString(eff))))
+  {
+    return;
+  }
+  id = eff;
   Trace("rels-lemma") << "Rels::lemma " << fact << " from " << reason << " by "
                       << id << std::endl;
   Node lemma = nodeManager()->mkNode(Kind::IMPLIES, reason, fact);
