(set-logic ALL)
(declare-sort E 0)
(declare-const A (Relation E E)) (declare-const B (Relation E E))
(declare-const C (Relation E E)) (declare-const D (Relation E E))
(declare-const H (Relation E E))
(assert (set.subset A H))
(assert (set.subset (rel.join H H) H))
(assert (not (rel.cyclic H)))
(assert (rel.cyclic A))
(check-sat)
