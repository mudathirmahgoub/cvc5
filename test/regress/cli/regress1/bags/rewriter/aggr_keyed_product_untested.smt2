; A keyed aggregate in a product whose filter does not test its counter keeps
; its row of initial values
(set-logic HO_ALL)
(set-info :status sat)
(declare-const X (Bag (Tuple Int Int)))
(declare-const Y (Bag (Tuple Int)))
(assert (= (bag.setof ((_ table.project 0) X)) ((_ table.project 0) X)))
(define-fun f ((t (Tuple Int Int)) (acc (Tuple Int Int))) (Tuple Int Int)
  (tuple ((_ tuple.select 0) t) (+ ((_ tuple.select 1) acc) 1)))
(define-fun G () (Bag (Tuple Int Int)) ((_ table.aggr 0) f (tuple 0 0) X))
; X empty: G = {(0, 0)}, and with Y nonempty the product has a row the filter keeps (it tests Y only)
(assert (= (bag.card X) 0))
(assert (= Y (bag (tuple 1) 1)))
(assert (not (= (bag.filter (lambda ((r (Tuple Int Int Int))) (>= ((_ tuple.select 2) r) 0)) (table.product G Y))
                (as bag.empty (Bag (Tuple Int Int Int))))))
(check-sat)
