; AGGREGATE_ROLLUP merges an outer maximum of the inner maximums into one
; maximum over X only when it reads the inner column as it is: for
;   SELECT k, MAX(m + 1) FROM (SELECT k, j, MAX(b) AS m FROM X GROUP BY k, j)
;   GROUP BY k
; the merge dropped the + 1, and X = {(1, 1, 3)} gave 3 for 4
(set-logic HO_ALL)
(set-info :status unsat)
(declare-const X (Bag (Tuple (Nullable Int) (Nullable Int) (Nullable Int))))
(define-fun mx ((a (Nullable Int)) (s (Nullable Int))) (Nullable Int)
  (ite (nullable.is_null a) s
       (ite (nullable.is_null s) a (ite (> (nullable.val a) (nullable.val s)) a s))))
(define-fun f ((t (Tuple (Nullable Int) (Nullable Int) (Nullable Int)))
               (acc (Tuple (Nullable Int) (Nullable Int) (Nullable Int) Int)))
  (Tuple (Nullable Int) (Nullable Int) (Nullable Int) Int)
  (tuple ((_ tuple.select 0) t) ((_ tuple.select 1) t)
         (mx ((_ tuple.select 2) t) ((_ tuple.select 2) acc)) (+ ((_ tuple.select 3) acc) 1)))
(define-fun g ((u (Tuple (Nullable Int) (Nullable Int) (Nullable Int) Int))
               (acc (Tuple (Nullable Int) (Nullable Int) Int)))
  (Tuple (Nullable Int) (Nullable Int) Int)
  (tuple ((_ tuple.select 0) u)
         (mx (ite (nullable.is_null ((_ tuple.select 2) u)) (as nullable.null (Nullable Int))
                  (nullable.some (+ (nullable.val ((_ tuple.select 2) u)) 1)))
             ((_ tuple.select 1) acc))
         (+ ((_ tuple.select 2) acc) 1)))
(define-fun inner () (Bag (Tuple (Nullable Int) (Nullable Int) (Nullable Int) Int))
  (bag.filter (lambda ((r (Tuple (Nullable Int) (Nullable Int) (Nullable Int) Int))) (>= ((_ tuple.select 3) r) 1))
    ((_ table.aggr 0 1) f (tuple (as nullable.null (Nullable Int)) (as nullable.null (Nullable Int))
                                 (as nullable.null (Nullable Int)) 0) X)))
(define-fun q () (Bag (Tuple (Nullable Int) (Nullable Int)))
  (bag.map (lambda ((r (Tuple (Nullable Int) (Nullable Int) Int))) (tuple ((_ tuple.select 0) r) ((_ tuple.select 1) r)))
    (bag.filter (lambda ((r (Tuple (Nullable Int) (Nullable Int) Int))) (>= ((_ tuple.select 2) r) 1))
      ((_ table.aggr 0) g (tuple (as nullable.null (Nullable Int)) (as nullable.null (Nullable Int)) 0) inner))))
(assert (= X (bag (tuple (nullable.some 1) (nullable.some 1) (nullable.some 3)) 1)))
(assert (not (bag.member (tuple (nullable.some 1) (nullable.some 4)) q)))
(check-sat)
